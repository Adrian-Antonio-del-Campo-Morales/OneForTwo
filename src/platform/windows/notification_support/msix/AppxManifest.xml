<?xml version="1.0" encoding="utf-8"?>
<!--
  Native validation package for the notifications module.

  This manifest packages oneintwo_notifications_native_windows.exe with a
  package identity and the userNotificationListener capability. Add the
  capability and product identity to the product's own AppxManifest.xml.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap3 rescap">

    <Identity
        Name="OneInTwo.Notifications.NativeCheck"
        Publisher="CN=OneInTwo Development"
        Version="1.0.0.0"
        ProcessorArchitecture="x64" />

    <Properties>
        <DisplayName>OneInTwo Native Notifications Check</DisplayName>
        <PublisherDisplayName>OneInTwo</PublisherDisplayName>
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>

    <Dependencies>
        <TargetDeviceFamily
            Name="Windows.Desktop"
            MinVersion="10.0.17763.0"
            MaxVersionTested="10.0.26100.0" />
    </Dependencies>

    <Resources>
        <Resource Language="en-us" />
    </Resources>

    <Applications>
        <Application
            Id="NativeCheck"
            Executable="oneintwo_notifications_native_windows.exe"
            EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements
                DisplayName="OneInTwo Native Notifications Check"
                Description="Native check of the notification package"
                BackgroundColor="#0078D4"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png" />
        </Application>
    </Applications>

    <Capabilities>
        <uap3:Capability Name="userNotificationListener" />
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>
</Package>
