<?xml version="1.0" encoding="utf-8"?>
<!--
  Fragment for the OneInTwo MSIX package's AppxManifest.xml.

  Observing notifications from other applications requires package identity
  and the userNotificationListener capability. Without both, the adapter
  reports observe=false and startObserving returns unavailable or denied.

  Add the capability to the product manifest and keep the OneInTwo.Desktop
  application identity declared in src/features/notification_support/identity.hpp.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

    <Capabilities>
        <Capability Name="internetClient" />
        <!-- Read notifications with the local user’s consent. -->
        <uap3:Capability Name="userNotificationListener" />
        <!-- Required for a packaged desktop application. -->
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>

</Package>
